<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <BlazorWebAssemblyEnableStaticWebAssetsFingerprinting>false</BlazorWebAssemblyEnableStaticWebAssetsFingerprinting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
	  <InvariantGlobalization>true</InvariantGlobalization>
	  <BlazorEnableCompression>false</BlazorEnableCompression>
	  <BrotliCompression>false</BrotliCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="Refit" Version="16.4.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveAuction.Shared\LiveAuction.Shared.csproj" />
  </ItemGroup>

</Project>
